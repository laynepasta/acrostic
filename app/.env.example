# Your own Gemini API key, free to create at aistudio.google.com (separate
# from your claude.ai account).
GEMINI_API_KEY=

# Optional. Only set this if the default model in app/api/generate/route.ts
# stops working (Google renames or retires models over time). Check
# https://ai.google.dev/gemini-api/docs/models for the current name.
GEMINI_MODEL=

# From your Supabase project settings > Data API (URL) and > API Keys > Legacy
# API Keys (service_role key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
